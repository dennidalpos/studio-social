# Con true la generazione e la pubblicazione sono simulate.
DEMO=true
PORT=3000
# Con TLS, usa https://localhost:3000 e registra l'esatto URL di callback in LinkedIn.
# TLS_CERT_FILE=/percorso/localhost.pem
# TLS_KEY_FILE=/percorso/localhost-key.pem

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Provider iniziale del piano: openai, claude, qwen, gemini, antigravity, compatible.
# Puoi scegliere un altro provider nella dashboard e salvare il piano.
LLM_PROVIDER=openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
QWEN_API_KEY=
QWEN_MODEL=qwen3.7-plus
QWEN_BASE_URL=https://ap-southeast-1.maas.qwencloudapi.com/compatible-mode/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTIGRAVITY_AGENT=antigravity-preview-05-2026
ANTIGRAVITY_MODEL=gemini-3.8-flash
COMPAT_BASE_URL=
COMPAT_API_KEY=
COMPAT_MODEL=
# Facoltativo: minuti di attesa della risposta AI per i modelli lenti (da 0,1 a 60). Vuoto: 1 minuto.
# AI_TIMEOUT_MINUTES=5
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Token della Pagina Facebook. Copia l'ID della stessa Pagina.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
FACEBOOK_GRAPH_VERSION=v27.0

# Versione API per i video LinkedIn
LINKEDIN_VERSION=202610

# Facoltativi, se Instagram usa una Pagina o un token diverso da Facebook.
INSTAGRAM_PAGE_ID=
INSTAGRAM_PAGE_TOKEN=

# Per le foto Instagram, indica la cartella servita via HTTPS e il suo URL pubblico.
INSTAGRAM_PUBLIC_DIR=
INSTAGRAM_PUBLIC_BASE_URL=
